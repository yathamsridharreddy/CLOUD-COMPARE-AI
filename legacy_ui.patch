 const API_BASE = (runtimeConfig.API_BASE || import.meta.env.VITE_API_BASE || '').replace(/\/$/, '')
-const api = axios.create({ baseURL: `${API_BASE}/api`, headers: { 'Content-Type': 'application/json' }, timeout: 30000 })
