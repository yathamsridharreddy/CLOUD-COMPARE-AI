diff --git a/cloudcompare-frontend/src/legacy-dashboard.css b/cloudcompare-frontend/src/legacy-dashboard.css
new file mode 100644
index 0000000..17fd36d
--- /dev/null
+++ b/cloudcompare-frontend/src/legacy-dashboard.css
@@ -0,0 +1,1589 @@
+/* ============================================================
+   CLOUDCOMPARE AI - PREMIUM DARK NAVY & TEAL THEME
+   ============================================================ */
+
+/* Dark Navy & Teal CSS Variables */
+:root {
+    --primary: #00d2ff;
+    --primary-dark: #00b894;
+    --secondary: #8a2be2;
+    --success: #22c55e;
+    --warning: #fbbf24;
+    --danger: #ef4444;
+    --dark-bg: #030014;
+    --dark-card: rgba(15, 23, 42, 0.85);
+    --dark-border: rgba(0, 210, 255, 0.12);
+    --glass-bg: rgba(15, 23, 42, 0.6);
+    --glass-border: rgba(0, 210, 255, 0.1);
+    --text-primary: #ffffff;
+    --text-secondary: #94a3b8;
+    --text-muted: #475569;
+    --gradient: linear-gradient(135deg, #00d2ff, #8a2be2);
+    --gradient-warm: linear-gradient(135deg, #00d2ff, #8a2be2);
+    --gradient-cool: linear-gradient(135deg, #8a2be2, #00d2ff);
+    --gradient-purple: linear-gradient(135deg, #8a2be2, #a78bfa);
+    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
+    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.6);
+    --shadow-glow: 0 0 40px rgba(0, 210, 255, 0.1);
+    --gold-shimmer: linear-gradient(135deg, #00d2ff 0%, #8a2be2 40%, #00d2ff 60%, #059669 100%);
+}
+
+/* Reset & Base */
+* {
+    margin: 0;
+    padding: 0;
+    box-sizing: border-box;
+}
+
+body {
+    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+    background-color: var(--dark-bg);
+    color: var(--text-primary);
+    line-height: 1.6;
+    min-height: 100vh;
+    overflow-x: hidden;
+    position: relative;
+}
+
+/* Dynamic Space Background */
+body::before {
+    content: ''; 
+    position: fixed; 
+    inset: 0; 
+    z-index: -2;
+    background: 
+        radial-gradient(ellipse at 80% 50%, rgba(138, 43, 226, 0.15) 0%, transparent 50%),
+        radial-gradient(ellipse at 20% 80%, rgba(0, 210, 255, 0.1) 0%, transparent 40%);
+}
+
+/* Stars effect */
+.stars { 
+    position: fixed; 
+    inset: 0; 
+    z-index: -1; 
+    background-image: radial-gradient(#ffffff 1px, transparent 1px); 
+    background-size: 50px 50px; 
+    opacity: 0.1; 
+}
+
+/* App Container */
+.app-container {
+    max-width: 1400px;
+    margin: 0 auto;
+    min-height: 100vh;
+    display: flex;
+    flex-direction: column;
+}
+
+/* Header - Glassmorphism */
+.header {
+    background: transparent;
+    backdrop-filter: blur(20px);
+    -webkit-backdrop-filter: blur(20px);
+    border-bottom: 1px solid rgba(255,255,255,0.05);
+    padding: 1.5rem 2rem;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 1rem;
+}
+
+.logo {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+}
+
+.logo-icon {
+    width: 32px;
+    height: 32px;
+    background: var(--gradient);
+    border-radius: 50%;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-size: 0.9rem;
+    color: white;
+}
+
+.logo-text h1 {
+    font-size: 1.5rem;
+    font-weight: 700;
+    color: var(--text-primary);
+}
+
+.logo-text span {
+    font-size: 0.85rem;
+    color: var(--text-secondary);
+}
+
+.header-actions {
+    display: flex;
+    gap: 12px;
+    flex-wrap: wrap;
+}
+
+.stats-badge {
+    background: var(--glass-bg);
+    backdrop-filter: blur(10px);
+    -webkit-backdrop-filter: blur(10px);
+    border: 1px solid var(--glass-border);
+    padding: 8px 16px;
+    border-radius: 12px;
+    font-size: 0.9rem;
+    color: var(--text-secondary);
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    transition: all 0.3s ease;
+}
+
+.stats-badge:hover {
+    background: rgba(0, 212, 170, 0.1);
+    border-color: var(--primary);
+    transform: translateY(-2px);
+    box-shadow: 0 4px 20px rgba(0, 212, 170, 0.15);
+}
+
+.stats-badge i {
+    color: var(--primary);
+}
+
+/* Main Content */
+.main-content {
+    flex: 1;
+    padding: 2rem;
+}
+
+/* Input Section - Glassmorphism */
+.input-section {
+    background: var(--glass-bg);
+    backdrop-filter: blur(20px);
+    -webkit-backdrop-filter: blur(20px);
+    border: 1px solid var(--glass-border);
+    border-radius: 24px;
+    padding: 2rem;
+    margin-bottom: 2rem;
+    box-shadow: var(--shadow-glow), 0 8px 32px rgba(0, 0, 0, 0.5);
+}
+
+.section-header {
+    margin-bottom: 2rem;
+}
+
+.section-header h2 {
+    font-size: 1.5rem;
+    margin-bottom: 0.5rem;
+    display: flex;
+    align-items: center;
+    gap: 12px;
+}
+
+.section-header h2 i {
+    color: var(--primary);
+}
+
+.section-header p {
+    color: var(--text-secondary);
+}
+
+/* Input Grid */
+.input-grid {
+    display: flex;
+    flex-direction: column;
+    gap: 1.5rem;
+}
+
+/* Input Row */
+.input-row {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
+    gap: 1rem;
+}
+
+/* Input Group */
+.input-group {
+    display: flex;
+    flex-direction: column;
+    gap: 0.5rem;
+}
+
+.input-group label {
+    font-weight: 500;
+    font-size: 0.9rem;
+    color: var(--text-secondary);
+    display: flex;
+    align-items: center;
+    gap: 8px;
+}
+
+.input-group label i {
+    color: var(--primary);
+    width: 16px;
+}
+
+.input-group input,
+.input-group select {
+    background: var(--glass-bg);
+    border: 1px solid var(--glass-border);
+    border-radius: 12px;
+    padding: 14px 16px;
+    color: var(--text-primary);
+    font-size: 1rem;
+    transition: all 0.3s;
+    width: 100%;
+}
+
+.input-group input:focus,
+.input-group select:focus {
+    outline: none;
+    border-color: var(--primary);
+    box-shadow: 0 0 0 4px rgba(0, 212, 170, 0.15), 0 0 30px rgba(0, 212, 170, 0.08);
+}
+
+.input-group input::placeholder {
+    color: var(--text-muted);
+}
+
+.input-group select option {
+    background: #0a1128;
+    color: #e2e8f0;
+    padding: 8px;
+}
+
+/* Category Buttons */
+.category-select {
+    margin-bottom: 0.5rem;
+}
+
+.service-buttons-container {
+    display: flex;
+    gap: 8px;
+    flex-wrap: wrap;
+    margin-top: 8px;
+}
+
+.service-type-btn {
+    background: var(--dark-bg);
+    border: 1px solid var(--dark-border);
+    border-radius: 8px;
+    padding: 8px 16px;
+    color: var(--text-secondary);
+    font-size: 0.9rem;
+    font-weight: 500;
+    cursor: pointer;
+    transition: all 0.3s;
+}
+
+.service-type-btn:hover {
+    border-color: var(--primary);
+    color: var(--text-primary);
+}
+
+.service-type-btn.active {
+    background: var(--gradient);
+    border-color: transparent;
+    color: white;
+}
+
+.category-buttons {
+    display: flex;
+    gap: 12px;
+    flex-wrap: wrap;
+}
+
+.category-btn {
+    background: var(--dark-bg);
+    border: 2px solid var(--dark-border);
+    border-radius: 12px;
+    padding: 16px 24px;
+    color: var(--text-secondary);
+    font-size: 1rem;
+    font-weight: 500;
+    cursor: pointer;
+    transition: all 0.3s;
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    flex: 1;
+    min-width: 150px;
+    justify-content: center;
+}
+
+.category-btn:hover {
+    border-color: var(--primary);
+    color: var(--text-primary);
+}
+
+.category-btn.active {
+    background: var(--gradient);
+    border-color: transparent;
+    color: white;
+}
+
+.category-btn i {
