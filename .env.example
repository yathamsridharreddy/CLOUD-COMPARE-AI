# ==================================================================
# CloudCompare AI — Environment Configuration
# ==================================================================
# Copy this file to .env and fill in the values before running.
# NEVER commit your actual .env file to version control.
# ==================================================================

# Groq API Configuration
GROK_API_KEYS=your-groq-api-key-here

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here-min-64-chars

# Database Configuration
DB_HOST=localhost
DB_NAME=cloudcompare
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Docker Image (used by docker-compose)
DOCKER_IMAGE=raghavendra2006/cloudcompare-ai:latest

# Optional free/no-domain password-reset email: Gmail HTTPS API.
# Configure ONLY on the backend. See docs/PASSWORD_RESET_GMAIL.md.
# Never put OAuth credentials in Vercel, frontend code, or Git.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_FRONTEND_ORIGIN=https://cloud-compareai.vercel.app
GMAIL_SENDER_EMAIL=your-sending-account@gmail.com
GMAIL_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GMAIL_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=YOUR_GOOGLE_OAUTH_REFRESH_TOKEN
